{
  "name": "encurtador-url-nest-js",
  "version": "1.0.0",
  "description": "Encurtador de URLs com NestJS e PostgreSQL",
  "author": "Maycon",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "npm run services:wait:database && npm run migrations:up && ENV_FILE=.env.development nest start --watch",
    "server": "npm run database:up && npm run dev",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "services:wait:database": "node src/infra/scripts/wait-for-postgres.js",
    "migrations:up": "node-pg-migrate -m src/infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m src/infra/migrations --envPath .env.development --dry-run up",
    "migrations:create": "node-pg-migrate --migrations-dir src/infra/migrations create",
    "lint:check": "npm run lint:eslint:check && npm run lint:prettier:check",
    "lint:eslint:check": "eslint .",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "test": "concurrently -n nest,jest  -k -s command-jest \"ENV_FILE=.env.development nest start\" \"wait-on http://localhost:3000 && jest --config ./test/jest-e2e.json --runInBand\"",
    "test:watch": "jest --config ./test/jest-e2e.json --watch --runInBand --verbose",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:unit": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "concurrently": "^10.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "wait-on": "^9.1.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}

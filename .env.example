# Database configuration

POSTGRES_HOST=postgres_encurtador
POSTGRES_PORT=5432
POSTGRES_USER=local_user
POSTGRES_DB=local_db
POSTGRES_PASSWORD=123
DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB

# Frontend URL configuration

FRONTEND_URL=http://localhost:3000

# Password pepper for hashing

PASSWORD_PEPPER=secret_pepper

# JWT configuration

JWT_ACCESS_SECRET=secret_access_jwt_key
JWT_REFRESH_SECRET=secret_refresh_jwt_key

# Email configuration

EMAIL_FROM_ADDRESS=contato@contato.com
EMAIL_SMTP_HOST=mailcatcher_encurtador
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=contato
EMAIL_SMTP_PASSWORD=password
EMAIL_HTTP_HOST=mailcatcher_encurtador
EMAIL_HTTP_PORT=1080

# Observability configuration

SENTRY_DSN="https://sua-chave-dsn-aqui@sentry.io/123456"

# Server configuration

PORT=3000

# Node environment

NODE_ENV=development